{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ten-minute-whiteboard",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "whiteboard.patrick-shenzhen.org",
      "custom_domain": true
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BOARD",
        "class_name": "ClipboardBoard"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ClipboardBoard"]
    }
  ],
  "vars": {
    "BOARD_TTL_SECONDS": "600"
  }
}
