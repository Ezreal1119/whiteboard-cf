{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ten-minute-whiteboard",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "whiteboard.patrick-shenzhen.org",
      "custom_domain": true
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BOARD",
        "class_name": "ClipboardBoard"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ClipboardBoard"
      ]
    }
  ],
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "whiteboard-attachments"
    }
  ],
  "vars": {
    "BOARD_TTL_SECONDS": "86400",
    "R2_S3_ENDPOINT": "https://570ff3ceb3e6abe16b9c7e2c59b7ed2d.r2.cloudflarestorage.com",
    "R2_BUCKET_NAME": "whiteboard-attachments"
  }
}
